static func ending(who: int, other: int) -> String:
	if who < 3 and other < 3: return ENDINGS[who][other]
	return ["狂笑越过荒原。猎物与猎手，都被卷进新的食物链。", "地面留下巨大的脚印。牛来回头，又喊了一声妈妈。", "外卖箱落在荒野尽头。这一单，送给下一个挑战者。"][maxi(0,who-3)] if who >= 3 else "黄色三幻神的传说被打破。食物链又一次重新排列。"

static func intro(who: int, opponent: int) -> String:
	if who == 3: return "胞兄厌我……" if opponent == 5 else "哈哈哈哈！"
	if who == 4:
		return "妈 —— 妈 ——！" if opponent in [3,5] else ("妈 ——！" if opponent == 1 else "妈……")
	if who == 5:
		return "少给我装蒜！" if opponent == 2 else ("抢生意抢到我头上来了！" if opponent == 4 else "胆子真是肥嘟嘟的！")
	if who == 0: return "咕咕嘎嘎！" if opponent != 2 else "咕咕～嘎嘎！"
	if who == 1: return "……（盯紧妙脆角耳朵）" if opponent == 2 else "我的刀盾！"
	return "干嘛？"

